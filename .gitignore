# --- Node ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# --- Build / output ---
dist/
coverage/
.turbo/
.cache/
*.tsbuildinfo

# --- Runtime / local output ---
logs/
.mcp-debug/
support-bundles/

# --- Release artifacts (keep metadata, skip heavy ZIP) ---
release/*.zip
release/verify-clean-*/
release/tmp-*/
release/staging-*/

# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
credentials/
credentials.*
token/
token.*
secret/
secret.*
*credentials*.json
*secret*.json
*token*.json

# --- OS / editor ---
.DS_Store
Thumbs.db
Desktop.ini
.vscode/settings.json

# --- Misc backups ---
*.bak
*.bak-*

# --- OCR tessdata (sync via npm run sync:tessdata / postinstall) ---
eng.traineddata
vie.traineddata
*.traineddata
resources/tessdata/*.gz
